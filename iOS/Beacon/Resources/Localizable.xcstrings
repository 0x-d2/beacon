    "On the Mac: Vorssaint › Settings › Monitor › Watch from iPhone › Add a phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’te: Vorssaint › Ayarlar › Monitör › iPhone’dan izle › Telefon ekle."
          }
        }
      }
    },
    "On this network": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ağda"
          }
        }
      }
    },
    "On your Mac, open Vorssaint's Settings › Monitor, turn on Watch from iPhone and add a phone. Then scan the code here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inde Vorssaint’in Ayarlar › Monitör sayfasını aç, iPhone’dan izle’yi açıp bir telefon ekle. Sonra kodu burada okut."
          }
        }
      }
    },
    "One of your Mac's readings, as the watch last saw it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inin ölçümlerinden biri, saatin en son gördüğü haliyle."
          }
        }
      }
    },
    "Open Beacon on the watch to see your Mac here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’ini burada görmek için saatte Beacon’ı aç."
          }
        }
      }
    },
    "Or paste the link": {
      "localizations": {
        "tr": {
          "stringUnit": {
